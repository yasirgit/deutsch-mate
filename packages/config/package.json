{
  "name": "@deutsch-mate/config",
  "version": "0.1.0",
  "private": true,
  "dm": {
    "tier": "shared",
    "clientSafe": false
  },
  "type": "module",
  "exports": {
    "./env": {
      "types": "./dist/env/index.d.ts",
      "default": "./dist/env/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.config.d.mts",
      "default": "./src/eslint.config.mjs"
    },
    "./prettier": {
      "types": "./dist/prettier.config.d.mts",
      "default": "./src/prettier.config.mjs"
    },
    "./dependency-cruiser": {
      "types": "./dist/dependency-cruiser.d.cts",
      "default": "./src/dependency-cruiser.cjs"
    },
    "./workspace-metadata": {
      "types": "./dist/workspace-metadata.d.cts",
      "default": "./src/workspace-metadata.cjs"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.env.json && tsc -p tsconfig.build.tooling.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.8.0",
    "typescript-eslint": "8.65.0",
    "zod": "4.4.3"
  }
}
