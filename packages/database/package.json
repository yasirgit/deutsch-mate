{
  "name": "@deutsch-mate/database",
  "version": "0.1.0",
  "private": true,
  "dm": {
    "tier": "shared",
    "clientSafe": false
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:authorization": "vitest run src/authorization.integration.test.ts",
    "test:integration": "vitest run src/ops/idempotency.integration.test.ts src/ops/messaging.integration.test.ts src/ops/audit.integration.test.ts",
    "test:resilience:duplicates": "vitest run src/ops/duplicates.resilience.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deutsch-mate/domain": "workspace:*",
    "kysely": "0.29.4",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@deutsch-mate/config": "workspace:*",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "eslint": "10.8.0",
    "kysely-codegen": "0.19.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
