{
  "name": "deutsch-mate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "bootstrap": "pnpm --filter @deutsch-mate/scripts bootstrap",
    "boundaries:check": "turbo run //#boundaries:check:impl",
    "boundaries:check:impl": "depcruise --config .dependency-cruiser.cjs apps packages scripts",
    "build": "turbo run build",
    "db:create-empty": "pnpm --filter @deutsch-mate/scripts db:create-empty",
    "db:migrate": "pnpm --filter @deutsch-mate/database build && pnpm --filter @deutsch-mate/scripts db:migrate",
    "db:migrations:verify": "pnpm --filter @deutsch-mate/database build && pnpm --filter @deutsch-mate/scripts db:migrations:verify",
    "db:reset": "pnpm --filter @deutsch-mate/database build && pnpm --filter @deutsch-mate/scripts db:reset",
    "db:codegen": "pnpm --filter @deutsch-mate/scripts db:codegen",
    "db:contract": "pnpm --filter @deutsch-mate/scripts db:contract",
    "db:constraints": "pnpm --filter @deutsch-mate/scripts db:constraints",
    "db:immutability": "pnpm --filter @deutsch-mate/scripts db:immutability",
    "db:rls": "pnpm --filter @deutsch-mate/scripts db:rls",
    "deps:check": "turbo run //#deps:check:impl",
    "deps:check:impl": "knip",
    "dev": "pnpm dev:services && turbo run dev",
    "dev:services": "docker compose up -d --wait",
    "dev:services:down": "docker compose down",
    "format": "turbo run format && prettier --write \"*.{json,md,mjs,yaml,yml}\"",
    "format:check": "turbo run format:check && prettier --check \"*.{json,md,mjs,yaml,yml}\"",
    "lint": "turbo run lint //#lint:impl",
    "lint:impl": "eslint .",
    "openapi:compat": "pnpm --filter @deutsch-mate/scripts openapi:compat",
    "openapi:drift": "pnpm --filter @deutsch-mate/scripts openapi:drift",
    "openapi:generate": "pnpm --filter @deutsch-mate/scripts openapi:generate",
    "openapi:lint": "redocly lint",
    "content:schema": "pnpm --filter @deutsch-mate/content-schemas content:schema",
    "content:validate": "pnpm --filter @deutsch-mate/content-pipeline build && pnpm --filter @deutsch-mate/scripts content:validate",
    "content:manifest": "pnpm --filter @deutsch-mate/content-pipeline build && pnpm --filter @deutsch-mate/scripts content:manifest",
    "content:import": "pnpm --filter @deutsch-mate/content-pipeline build && pnpm --filter @deutsch-mate/scripts content:import",
    "content:test-import": "pnpm --filter @deutsch-mate/content-pipeline build && pnpm --filter @deutsch-mate/scripts content:test-import",
    "content:publish": "pnpm --filter @deutsch-mate/scripts content:publish",
    "test": "turbo run test",
    "test:authorization": "pnpm --filter @deutsch-mate/scripts exec tsx test-authorization.ts",
    "test:contract": "pnpm --filter @deutsch-mate/scripts exec tsx test-contract.ts",
    "test:integration": "pnpm --filter @deutsch-mate/scripts exec tsx test-integration.ts",
    "test:e2e": "pnpm --filter @deutsch-mate/scripts exec tsx test-e2e.ts",
    "test:security": "pnpm --filter @deutsch-mate/scripts exec tsx test-security.ts",
    "test:resilience:duplicates": "pnpm --filter @deutsch-mate/scripts test:resilience:duplicates",
    "test:resilience": "pnpm --filter @deutsch-mate/scripts exec tsx test-resilience.ts",
    "test:rebuild-projections": "pnpm --filter @deutsch-mate/scripts exec tsx test-rebuild-projections.ts",
    "audit:export": "pnpm --filter @deutsch-mate/scripts audit:export",
    "test:smoke": "turbo run test:smoke",
    "test:telemetry-safety": "pnpm --filter @deutsch-mate/observability test:telemetry-safety",
    "typecheck": "turbo run typecheck"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0",
  "devDependencies": {
    "@deutsch-mate/config": "workspace:*",
    "@redocly/cli": "2.41.1",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.8.0",
    "knip": "6.29.0",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "6.0.3"
  }
}
