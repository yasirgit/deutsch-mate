# Local development configuration (DM-002).
#
# Copy to .env (pnpm bootstrap does this automatically). Never commit a real
# .env; .gitignore excludes it. Every value here is a non-secret local-only
# placeholder and MUST match the defaults in compose.yaml.

# --- compose.yaml service configuration ---
POSTGRES_PORT=54329
POSTGRES_USER=deutsch_mate
POSTGRES_PASSWORD=local-dev-only-not-a-secret
POSTGRES_DB=deutsch_mate_dev
REDIS_PORT=63799

# --- application configuration ---
NODE_ENV=development
# Set per process (api | ai-worker | billing-worker | privacy-worker |
# outbox-worker | media-worker). Production uses Secrets Manager IDs +
# workload identity instead of inline DATABASE_URL / REDIS_URL (DM-012).
# DM_SERVICE=api
LOG_LEVEL=info
DATABASE_URL=postgresql://deutsch_mate:local-dev-only-not-a-secret@localhost:54329/deutsch_mate_dev
REDIS_URL=redis://localhost:63799
API_PORT=3001
WEB_PORT=3000

# Cognito/OIDC (DM-035). Issuer + audience are config, not secrets.
# Provision the User Pool under DM-005/DM-006; see infra/cognito/README.md.
# OIDC_ISSUER=https://cognito-idp.eu-central-1.amazonaws.com/eu-central-1_example
# OIDC_AUDIENCE=example-app-client-id
# OIDC_JWKS_URI=  # optional; defaults to {OIDC_ISSUER}/.well-known/jwks.json

# Optional: password used by `pnpm db:migrate` to grant LOGIN on local runtime
# roles (dm_api, workers, dm_read_replica). Never put role passwords in SQL.
# Defaults to POSTGRES_PASSWORD. Ignored when NODE_ENV/DM_ENV is production.
# DATABASE_ROLE_PASSWORD=local-dev-only-not-a-secret
