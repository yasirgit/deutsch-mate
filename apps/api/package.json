{
  "name": "@deutsch-mate/api",
  "version": "0.1.0",
  "private": true,
  "dm": {
    "tier": "server"
  },
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@deutsch-mate/config": "workspace:*",
    "@nestjs/testing": "11.1.28",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@deutsch-mate/api-schemas": "workspace:*",
    "@deutsch-mate/content-pipeline": "workspace:*",
    "@deutsch-mate/database": "workspace:*",
    "@deutsch-mate/domain": "workspace:*",
    "@deutsch-mate/scoring": "workspace:*",
    "@deutsch-mate/review-algorithm": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@types/express": "5.0.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.2.1",
    "ioredis": "5.11.1",
    "jose": "6.2.5",
    "kysely": "0.29.4",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
