{
  "name": "@deutsch-mate/outbox-worker",
  "version": "0.1.0",
  "private": true,
  "dm": {
    "tier": "worker"
  },
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deutsch-mate/database": "workspace:*",
    "@deutsch-mate/domain": "workspace:*",
    "kysely": "0.29.4"
  },
  "devDependencies": {
    "@deutsch-mate/config": "workspace:*",
    "@types/node": "22.20.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
