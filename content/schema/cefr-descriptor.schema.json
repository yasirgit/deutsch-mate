{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "cefr_descriptor"
    },
    "descriptorKey": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)+$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "level": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2"
      ]
    },
    "skill": {
      "type": "string",
      "enum": [
        "reading",
        "listening",
        "writing",
        "vocabulary",
        "grammar"
      ]
    },
    "sourceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "sourceEdition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "descriptorText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "descriptorKey",
    "version",
    "level",
    "skill",
    "sourceName",
    "sourceEdition",
    "descriptorText"
  ],
  "additionalProperties": false
}
