{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "exact"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "case_folded"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "normalized"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "set"
        },
        "values": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "ordered"
        },
        "order": {
          "minItems": 2,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "required": [
        "kind",
        "order"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "matching"
        },
        "pairs": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "leftId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "rightId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "required": [
              "leftId",
              "rightId"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "pairs"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "weighted_alternatives"
        },
        "alternatives": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "weight": {
                "type": "string",
                "pattern": "^0\\.[0-9]{1,3}$|^1(?:\\.0{1,3})?$"
              },
              "match": {
                "type": "string",
                "enum": [
                  "exact",
                  "case_folded",
                  "normalized"
                ]
              }
            },
            "required": [
              "value",
              "weight",
              "match"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "alternatives"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "cloze"
        },
        "blanks": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "blankId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "accept": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "exact"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "case_folded"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "normalized"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "weighted_alternatives"
                      },
                      "alternatives": {
                        "minItems": 1,
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 500
                            },
                            "weight": {
                              "type": "string",
                              "pattern": "^0\\.[0-9]{1,3}$|^1(?:\\.0{1,3})?$"
                            },
                            "match": {
                              "type": "string",
                              "enum": [
                                "exact",
                                "case_folded",
                                "normalized"
                              ]
                            }
                          },
                          "required": [
                            "value",
                            "weight",
                            "match"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "alternatives"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "blankId",
              "accept"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "blanks"
      ],
      "additionalProperties": false
    }
  ]
}
