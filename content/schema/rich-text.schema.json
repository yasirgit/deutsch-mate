                "type": "boolean"
              },
              "items": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "children": {
                      "minItems": 1,
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/__schema0"
                      }
                    }
                  },
                  "required": [
                    "children"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "ordered",
              "items"
