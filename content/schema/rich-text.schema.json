              },
              "tone": {
                "type": "string",
                "enum": [
                  "note",
                  "tip",
                  "warning"
                ]
              },
              "children": {
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            },
            "required": [
              "type",
              "tone",
              "children"
            ],
            "additionalProperties": false
