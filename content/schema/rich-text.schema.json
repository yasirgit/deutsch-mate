              "type": {
                "type": "string",
                "const": "heading"
              },
              "level": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 2
                  },
                  {
                    "type": "number",
                    "const": 3
                  }
                ]
              },
              "children": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
