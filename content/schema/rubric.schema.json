{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rubricKey": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)+$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "dimensions": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "task_completion",
              "grammar",
              "vocabulary",
              "clarity"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "doc"
              },
              "version": {
                "type": "number",
                "const": 1
              },
              "blocks": {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "paragraph"
                        },
                        "children": {
                          "minItems": 1,
                          "maxItems": 64,
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/__schema0"
                          }
                        }
                      },
                      "required": [
                        "type",
                        "children"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "heading"
                        },
                        "level": {
                          "anyOf": [
                            {
                              "type": "number",
                              "const": 2
                            },
                            {
                              "type": "number",
                              "const": 3
                            }
                          ]
                        },
                        "children": {
                          "minItems": 1,
                          "maxItems": 32,
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/__schema0"
                          }
                        }
                      },
                      "required": [
                        "type",
                        "level",
                        "children"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "list"
                        },
                        "ordered": {
                          "type": "boolean"
                        },
                        "items": {
                          "minItems": 1,
                          "maxItems": 20,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "children": {
                                "minItems": 1,
                                "maxItems": 64,
                                "type": "array",
                                "items": {
                                  "$ref": "#/$defs/__schema0"
                                }
                              }
                            },
                            "required": [
                              "children"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "type",
                        "ordered",
                        "items"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "example"
                        },
                        "children": {
                          "minItems": 1,
                          "maxItems": 64,
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/__schema0"
                          }
                        }
                      },
                      "required": [
                        "type",
                        "children"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "callout"
                        },
                        "tone": {
                          "type": "string",
                          "enum": [
                            "note",
                            "tip",
                            "warning"
                          ]
                        },
                        "children": {
                          "minItems": 1,
                          "maxItems": 64,
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/__schema0"
                          }
                        }
                      },
                      "required": [
                        "type",
                        "tone",
                        "children"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "type",
              "version",
              "blocks"
            ],
            "additionalProperties": false
          },
          "maxPoints": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,4})(?:\\.[0-9]{1,3})?$"
          }
        },
        "required": [
          "code",
          "title",
          "description",
          "maxPoints"
        ],
        "additionalProperties": false
      }
    },
    "scoringRule": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "sum_dimensions"
        },
        "passThreshold": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,4})(?:\\.[0-9]{1,3})?$"
        }
      },
      "required": [
        "kind",
        "passThreshold"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "rubricKey",
    "version",
    "dimensions",
    "scoringRule"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "marks": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "bold",
                  "italic",
                  "underline"
                ]
              }
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "emphasis"
            },
            "children": {
              "minItems": 1,
              "maxItems": 32,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "strong"
            },
            "children": {
              "minItems": 1,
              "maxItems": 32,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "code"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
