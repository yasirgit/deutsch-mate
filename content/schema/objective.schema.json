{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "objective"
    },
    "objectiveKey": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)+$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "level": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2"
      ]
    },
    "skill": {
      "type": "string",
      "enum": [
        "reading",
        "listening",
        "writing",
        "vocabulary",
        "grammar"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "descriptors": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descriptorKey": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)+$"
          },
          "descriptorVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "descriptorKey",
          "descriptorVersion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "objectiveKey",
    "version",
    "level",
    "skill",
    "title",
    "description",
    "descriptors"
  ],
  "additionalProperties": false
}
