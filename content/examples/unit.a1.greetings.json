        "version": 1,
        "title": "Hallo und tschüss",
        "explanation": {
          "type": "doc",
          "version": 1,
          "blocks": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "German has formal and informal greetings. Use "
                },
                { "type": "strong", "children": [{ "type": "text", "text": "Guten Tag" }] },
                {
                  "type": "text",
                  "text": " with adults you do not know well."
                }
              ]
            },
            {
              "type": "callout",
              "tone": "tip",
              "children": [
                {
                  "type": "text",
                  "text": "Tschüss is informal; Auf Wiedersehen is more formal."
                }
              ]
            }
          ]
        },
        "examples": {
          "type": "doc",
          "version": 1,
          "blocks": [
            {
              "type": "example",
              "children": [
                { "type": "text", "text": "A: Guten Morgen! B: Guten Morgen, Frau Weber." }
              ]
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                { "children": [{ "type": "text", "text": "Hallo — informal hello" }] },
                { "children": [{ "type": "text", "text": "Tschüss — informal goodbye" }] }
              ]
            }
          ]
        },
        "completionRule": {
          "kind": "required_activities",
          "requireAllRequired": true
