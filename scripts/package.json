{
  "name": "@deutsch-mate/scripts",
  "version": "0.1.0",
  "private": true,
  "dm": {
    "tier": "tooling"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "tsx bootstrap-local.ts",
    "db:create-empty": "tsx db-create-empty.ts",
    "db:codegen": "tsx db-codegen.ts",
    "db:contract": "tsx db-contract.ts",
    "db:migrate": "tsx migrate.ts",
    "db:migrations:verify": "tsx db-migrations-verify.ts",
    "db:reset": "tsx db-reset.ts",
    "db:constraints": "tsx db-constraints.ts",
    "db:immutability": "tsx db-immutability.ts",
    "db:rls": "tsx db-rls.ts",
    "audit:export": "tsx audit-export.ts",
    "test:integration": "tsx test-integration.ts",
    "test:contract": "tsx test-contract.ts",
    "test:e2e": "tsx test-e2e.ts",
    "test:resilience:duplicates": "tsx test-resilience-duplicates.ts",
    "test:resilience": "tsx test-resilience.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "openapi:compat": "tsx openapi/compat.ts",
    "openapi:drift": "tsx openapi/drift.ts",
    "openapi:generate": "tsx openapi/generate.ts",
    "content:validate": "tsx content-validate.ts",
    "content:manifest": "tsx content-manifest.ts",
    "content:import": "tsx content-import.ts",
    "content:test-import": "tsx content-test-import.ts",
    "content:publish": "tsx content-publish.ts",
    "test": "vitest run --passWithNoTests",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "tsc --noEmit",
    "wait-for-services": "tsx wait-for-services.ts"
  },
  "devDependencies": {
    "@deutsch-mate/config": "workspace:*",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@deutsch-mate/content-pipeline": "workspace:*",
    "@deutsch-mate/database": "workspace:*",
    "@deutsch-mate/domain": "workspace:*",
    "ioredis": "5.11.1",
    "openapi-typescript": "7.13.0",
    "pg": "8.22.0",
    "yaml": "2.9.0"
  }
}
